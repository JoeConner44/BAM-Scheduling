# Postgres connection. On Vercel + Neon both are filled in automatically.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bam?schema=public"
# Direct (non-pooled) connection used for migrations. Locally, the same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/bam?schema=public"

# Optional: shared code everyone must enter on the sign-in page (recommended for a public demo link).
SITE_PASSWORD=""
# Optional: set to "false" to hide the owner's "Reset sample data" button (do this before using real data).
ALLOW_DEMO_RESET="true"
